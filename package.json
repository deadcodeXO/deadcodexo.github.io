{
  "name": "devosfera",
  "type": "module",
  "main": "electron/main.js",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "cms:server": "decap-server",
    "dev:cms": "concurrently --kill-others --kill-others-on-fail --success first --handle-input false \"npm run dev\" \"npm run cms:server\"",
    "build": "astro build && node scripts/remove-dev-routes.cjs && pagefind --site dist && node scripts/copy-pagefind.cjs",
    "new:post": "node scripts/new-post.cjs",
    "syncdocs": "node scripts/sync-docs.cjs",
    "readyprod": "npm run build && npm run syncdocs",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "cms:app": "electron .",
    "cms:app:portable": "electron-builder --win portable",
    "cms:app:installer": "electron-builder --win nsis",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/transformers": "^3.23.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.0.8",
    "dayjs": "^1.11.19",
    "decap-server": "^3.5.2",
    "lodash.kebabcase": "^4.1.1",
    "monaco-editor": "^0.53.0",
    "monacopilot": "^1.2.12",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.19.2",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@pagefind/default-ui": "^1.4.0",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.57.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.6.0",
    "globals": "^17.3.0",
    "pagefind": "^1.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "net.functionabuse.deadcodexo.cms",
    "productName": "DCs Content Editor",
    "icon": "electron/icon.png",
    "asar": true,
    "files": [
      "**/*",
      "!electron.md",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "app": "electron"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "overrides": {
    "fast-xml-parser": "5.5.9"
  }
}
