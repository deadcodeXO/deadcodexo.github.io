  /* Global Build Button */
  #global-build-ui {
    position: fixed;
    bottom: 1rem;
    right: 1rem;
    z-index: 9998;
  }
  #global-build-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid #5f97c5;
    background: rgba(16, 18, 26, 0.9);
    color: #d9e5ff;
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  #global-build-btn:hover {
    background: rgba(95, 151, 197, 0.2);
    transform: scale(1.1);
  }
  #global-build-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  html[data-theme="light"] #global-build-btn {
    background: rgba(248, 249, 250, 0.9);
    color: #212529;
    border-color: #5f97c5;
  }
  .global-build-toast {
    position: absolute;
    bottom: 50px;
    right: 0;
    min-width: 200px;
    padding: 0.5rem 0.75rem;
    border-radius: 0.45rem;
    background: rgba(15, 17, 24, 0.95);
    color: #eaf3ff;
    border: 1px solid #5f97c5;
    font-size: 0.8rem;
    text-align: center;
  }
  .global-build-toast.hidden { display: none; }
</style>

<script>
  let cursorCleanup: AbortController | null = null;

  document.addEventListener("astro:page-load", () => {
    // Cleanup previous listeners
    if (cursorCleanup) cursorCleanup.abort();
    cursorCleanup = new AbortController();
    const { signal } = cursorCleanup;

    // Skip cursor glow on touch-only devices (no pointer cursor)
    if (window.matchMedia("(pointer: coarse)").matches) return;

    const cursorGlow = document.querySelector<HTMLElement>(".site-cursor-glow");
    let ticking = false;

    if (cursorGlow) {
      document.addEventListener(
        "mousemove",
        (e: MouseEvent) => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              cursorGlow.style.setProperty("--site-cx", `${e.clientX}px`);
              cursorGlow.style.setProperty("--site-cy", `${e.clientY}px`);
              if (!cursorGlow.classList.contains("active")) {
                cursorGlow.classList.add("active");
              }
              ticking = false;
            });
            ticking = true;
          }
        },
        { signal }
      );

      document.addEventListener(
        "mouseleave",
        () => {
          cursorGlow.classList.remove("active");
        },
        { signal }
      );
    }

    // Window controls for Electron
    if ((window as any).electronAPI && !(window as any).__windowControlsSetUp) {
      (window as any).__windowControlsSetUp = true;
      const minimizeBtn = document.getElementById("minimize-btn");
      const maximizeBtn = document.getElementById("maximize-btn");
      const closeBtn = document.getElementById("close-btn");

      if (minimizeBtn) {
        minimizeBtn.addEventListener("click", () => {
          (window as any).electronAPI!.minimizeWindow().catch(() => {});
        });
      }

      if (maximizeBtn) {
        maximizeBtn.addEventListener("click", () => {
          (window as any).electronAPI!.maximizeWindow().catch(() => {});
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener("click", () => {
          (window as any).electronAPI!.closeWindow().catch(() => {});
        });
      }
    }

    // Global build button (only show if Electron API available)
    const globalBuildUI = document.getElementById("global-build-ui");
    const globalBuildBtn = document.getElementById("global-build-btn");
    const globalBuildToast = document.getElementById("global-build-toast");

    if ((window as any).electronAPI && globalBuildUI) {
      globalBuildUI.style.display = "block";

      if (globalBuildBtn && !(globalBuildBtn as any)._handlerSet) {
        (globalBuildBtn as any)._handlerSet = true;
        
        const showToast = (message: string, type = "info") => {
          if (globalBuildToast) {
            globalBuildToast.textContent = message;
            globalBuildToast.classList.remove("hidden");
            setTimeout(() => globalBuildToast.classList.add("hidden"), 3000);
          }
        };

        globalBuildBtn.addEventListener("click", () => {
          if (globalBuildBtn.disabled) return;
          
          globalBuildBtn.disabled = true;
          showToast("Building site...", "busy");
          
          (window as any).electronAPI!.runReadyProd().catch(() => {
            globalBuildBtn.disabled = false;
            showToast("Build failed", "error");
          });
        });

        // Listen for build events
        (window as any).electronAPI!.onReadyProdEvent((payload: any) => {
          if (!payload) return;
          
          if (payload.type === "success") {
            globalBuildBtn.disabled = false;
            showToast("Build complete!", "success");
            if ((window as any).electronAPI) {
              (window as any).electronAPI!.showNotification("Build Complete", "Your site has been built successfully!").catch(() => {});
            }
          } else if (payload.type === "failure" || payload.type === "error") {
            globalBuildBtn.disabled = false;
            showToast("Build failed", "error");
          }
        });

        // Check initial status
        (window as any).electronAPI!.getReadyProdStatus().then((status: any) => {
          if (status?.running) {
            globalBuildBtn.disabled = true;
            showToast("Build in progress...", "busy");
          }
        });
      }
    }
  });
</script>
