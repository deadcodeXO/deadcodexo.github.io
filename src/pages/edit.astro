---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const isDev = import.meta.env.DEV;
---

<Layout title="Edit | Devosfera">
  <Header />
  <main id="main-content" class="app-layout py-12">
    <section class="mx-auto w-full max-w-6xl rounded-2xl border border-border/40 bg-background/75 p-6 backdrop-blur-sm">
      <h1 class="text-2xl font-semibold">Content Editor</h1>
      {
        isDev ? (
          <>
            <div class="mt-5 overflow-hidden rounded-xl border border-border/40 bg-white">
              <iframe
                src="/admin/"
                title="Decap CMS"
                class="h-[78vh] min-h-[680px] w-full"
              ></iframe>
            </div>
          </>
        ) : (
          <p class="mt-3 opacity-80">
            The editor route is intended for local development.
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
