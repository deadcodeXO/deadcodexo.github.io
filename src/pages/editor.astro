---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const isDev = import.meta.env.DEV;
---

<Layout title="Editor | DEADCODEXO">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pt-3 pb-12">
    <section class="mx-auto w-full max-w-6xl rounded-2xl border border-border/40 bg-background/75 p-6 backdrop-blur-sm">
      <h1 class="text-2xl font-semibold text-accent">Content Editor</h1>
      {
        isDev ? (
          <>
            <div class="mt-5 overflow-hidden rounded-xl border border-border/40 bg-background/40">
              <iframe
                id="cms-frame"
                src="/admin/"
                title="Decap CMS"
                class="h-[68vh] min-h-[600px] w-full"
              ></iframe>
            </div>
          </>
        ) : (
          <p class="mt-3 opacity-80">
            The `/editor` route is intended for local development.
          </p>
        )
      }
    </section>
  </main>

  <div id="console-pane" class="console-pane">
    <div class="console-header">
      <div class="console-buttons">
        <button id="toggle-console" type="button">Hide Console</button>
        <button id="clear-console" type="button">Clear</button>
      </div>
    </div>
    <div id="console-output" class="console-output"></div>
  </div>

  <div id="status-bar" class="status-bar">
    <span id="status-text">Ready</span>
  </div>

  <div id="readyprod-ui" aria-live="polite">
    <button id="settings-btn" type="button">⚙️</button>
    <button id="open-browser-btn" type="button">Open Site</button>
    <button id="readyprod-button" type="button">Build Site</button>
    <div id="readyprod-toast" class="readyprod-toast hidden"></div>
  </div>

  <div id="settings-modal" class="settings-modal hidden">
    <div class="settings-content">
      <h3>Settings</h3>
      <label>
        <input type="checkbox" id="auto-build-toggle"> Auto-build on file changes
      </label>
      <label>
        Console Font Size:
        <select id="console-font-size">
          <option value="0.75rem">Small</option>
          <option value="0.85rem" selected>Medium</option>
          <option value="1rem">Large</option>
        </select>
      </label>
      <button id="save-settings">Save</button>
      <button id="close-settings">Close</button>
    </div>
  </div>
  {
    isDev && (
      <script is:inline>
        (() => {
          if (window.__cmsThemeSyncInitialized) return;
          window.__cmsThemeSyncInitialized = true;

          const resolveCmsFrameSrc = () => {
            const search = new URLSearchParams(window.location.search);
            const proxyPort = search.get("cms_proxy_port");
            if (!proxyPort || !/^\d+$/.test(proxyPort)) return "/admin/";
            return `/admin/?cms_proxy_port=${encodeURIComponent(proxyPort)}`;
          };

          const sendThemeToCmsFrame = () => {
            const frame = document.getElementById("cms-frame");
            if (!frame || !frame.contentWindow) return;

            const currentTheme =
              document.documentElement.getAttribute("data-theme") ||
              localStorage.getItem("theme") ||
              "dark";

            frame.contentWindow.postMessage(
              { type: "site-theme", value: currentTheme },
              window.location.origin
            );
          };

          const setupCmsThemeSync = () => {
            const frame = document.getElementById("cms-frame");
            if (!frame) return;

            const nextSrc = resolveCmsFrameSrc();
            if (frame.getAttribute("src") !== nextSrc) {
              frame.setAttribute("src", nextSrc);
            }

            frame.addEventListener("load", sendThemeToCmsFrame);
            sendThemeToCmsFrame();

            const observer = new MutationObserver(sendThemeToCmsFrame);
            observer.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["data-theme"],
            });

            window.addEventListener("storage", event => {
              if (event.key === "theme") sendThemeToCmsFrame();
            });
          };

          document.addEventListener("astro:page-load", setupCmsThemeSync);
          setupCmsThemeSync();
        })();
      </script>
    )
  }
  <script is:inline>
    // @ts-ignore
    (() => {
      const initEditorPage = () => {
        const button = document.getElementById("readyprod-button");
        const openBrowserBtn = document.getElementById("open-browser-btn");
        const settingsBtn = document.getElementById("settings-btn");
        const settingsModal = document.getElementById("settings-modal");
        const autoBuildToggle = document.getElementById("auto-build-toggle");
        const consoleFontSize = document.getElementById("console-font-size");
        const saveSettingsBtn = document.getElementById("save-settings");
        const closeSettingsBtn = document.getElementById("close-settings");
        const statusText = document.getElementById("status-text");
        const toast = document.getElementById("readyprod-toast");
        const consoleOutput = document.getElementById("console-output");
        const clearConsoleBtn = document.getElementById("clear-console");
        const toggleConsoleBtn = document.getElementById("toggle-console");
        const consolePane = document.getElementById("console-pane");

        const appendToConsole = (message) => {
          if (!consoleOutput) return;
          const timestamp = new Date().toLocaleTimeString();
          consoleOutput.textContent += `[${timestamp}] ${message}\n`;
          consoleOutput.scrollTop = consoleOutput.scrollHeight;
        };

        const setStatus = (text) => {
          if (statusText) statusText.textContent = text;
        };

        const setToast = (message, status) => {
          if (!toast) return;
          toast.textContent = message;
          toast.classList.remove("hidden");
          toast.style.borderColor = status === "success" ? "#42c567" : status === "failure" ? "#f16353" : "#5f97c5";
          if (status !== "busy") {
            setTimeout(() => {
              toast.classList.add("hidden");
            }, 3600);
          }
        };
        const setButtonEnabled = (enabled) => {
          if (!button) return;
          button.disabled = !enabled;
        };

        if (clearConsoleBtn) {
          clearConsoleBtn.addEventListener("click", () => {
            if (consoleOutput) consoleOutput.textContent = "";
          });
        }

        if (toggleConsoleBtn && consolePane) {
          // Remove existing listeners to prevent duplicates
          toggleConsoleBtn.removeEventListener("click", toggleConsoleBtn._toggleHandler);
          
          const toggleHandler = () => {
            const isMinimized = consolePane.classList.contains("minimized");
            const cmsFrame = document.getElementById("cms-frame");
            const statusBar = document.getElementById("status-bar");
            if (isMinimized) {
              consolePane.classList.remove("minimized");
              toggleConsoleBtn.textContent = "Hide Console";
              if (cmsFrame) cmsFrame.style.height = "68vh";
              if (statusBar) statusBar.style.bottom = "200px";
            } else {
              consolePane.classList.add("minimized");
              toggleConsoleBtn.textContent = "Show Console";
              if (cmsFrame) cmsFrame.style.height = "78vh";
              if (statusBar) statusBar.style.bottom = "45px";
            }
          };
          
          toggleConsoleBtn._toggleHandler = toggleHandler;
          toggleConsoleBtn.addEventListener("click", toggleHandler);
        }

        // Open browser button
        if (openBrowserBtn && window.electronAPI) {
          openBrowserBtn.addEventListener("click", () => {
            window.electronAPI.openExternal("http://localhost:4321").catch(() => {});
          });
        }

        // Settings
        if (settingsBtn) {
          settingsBtn.addEventListener("click", () => {
            if (settingsModal) settingsModal.classList.remove("hidden");
            // Load settings
            if (autoBuildToggle) autoBuildToggle.checked = localStorage.getItem("autoBuild") === "true";
            if (consoleFontSize) consoleFontSize.value = localStorage.getItem("consoleFontSize") || "0.85rem";
          });
        }

        if (saveSettingsBtn) {
          saveSettingsBtn.addEventListener("click", () => {
            localStorage.setItem("autoBuild", autoBuildToggle?.checked ? "true" : "false");
            localStorage.setItem("consoleFontSize", consoleFontSize?.value || "0.85rem");
            if (consoleOutput) consoleOutput.style.fontSize = consoleFontSize?.value || "0.85rem";
            if (settingsModal) settingsModal.classList.add("hidden");
          });
        }

        if (closeSettingsBtn) {
          closeSettingsBtn.addEventListener("click", () => {
            if (settingsModal) settingsModal.classList.add("hidden");
          });
        }

        // Keyboard shortcuts
        document.addEventListener("keydown", (e) => {
          if (e.ctrlKey || e.metaKey) {
            switch (e.key) {
              case "b":
              case "B":
                e.preventDefault();
                if (button && !button.disabled) button.click();
                break;
              case "c":
              case "C":
                e.preventDefault();
                if (toggleConsoleBtn) toggleConsoleBtn.click();
                break;
              case "r":
              case "R":
                e.preventDefault();
                // Refresh CMS
                const cmsFrame = document.getElementById("cms-frame");
                if (cmsFrame) cmsFrame.src = cmsFrame.src;
                break;
            }
          }
        });

        // Context menu
        document.addEventListener("contextmenu", (e) => {
          e.preventDefault();
          if (window.electronAPI) {
            window.electronAPI.showContextMenu().catch((err) => console.error("Context menu error:", err));
          }
        });

        // Listen for refresh-cms from main
        if (window.electronAPI) {
          window.addEventListener("message", (e) => {
            if (e.data.type === "refresh-cms") {
              const cmsFrame = document.getElementById("cms-frame");
              if (cmsFrame) cmsFrame.src = cmsFrame.src;
            }
          });
        }

        // Load settings
        const savedFontSize = localStorage.getItem("consoleFontSize") || "0.85rem";
        if (consoleOutput) consoleOutput.style.fontSize = savedFontSize;
        if (consoleFontSize) consoleFontSize.value = savedFontSize;

        const initElectronReadyProd = () => {
          if (!button) return false;

          if (!window.electronAPI) {
            return false;
          }

          // Refresh CMS listener
          window.electronAPI.onRefreshCms(() => {
            const cmsFrame = document.getElementById("cms-frame");
            if (cmsFrame) cmsFrame.src = cmsFrame.src;
          });

          let buildTimeout = null;

          button.addEventListener("click", () => {
            setButtonEnabled(false);
            setToast("Building site...", "busy");
            setStatus("Building...");
            appendToConsole("Starting build site...");

            // Fallback: re-enable after 90s if stuck
            buildTimeout = setTimeout(() => {
              setButtonEnabled(true);
              setToast("Build timed out — try again", "failure");
              setStatus("Build timed out");
              appendToConsole("Build timed out after 90 seconds.");
            }, 90000);

            window.electronAPI.runReadyProd().catch(() => {
              clearTimeout(buildTimeout);
              setButtonEnabled(true);
              setToast("Build failed", "failure");
              setStatus("Build failed");
              appendToConsole("Build failed.");
            });
          });

          window.electronAPI.onReadyProdEvent((payload) => {
            if (!payload) return;
            if (payload.type === "start" || payload.type === "trigger" || payload.type === "busy") {
              setToast(payload.message || "Building site...", "busy");
              setButtonEnabled(false);
              setStatus("Building...");
              appendToConsole(payload.message || "Build started.");
              return;
            }
            if (payload.type === "log") {
              setToast(payload.message, "busy");
              appendToConsole(payload.message);
              return;
            }
            if (payload.type === "success") {
              clearTimeout(buildTimeout);
              setToast(payload.message || "Build complete", "success");
              setButtonEnabled(true);
              setStatus("Build complete");
              appendToConsole(payload.message || "Build completed successfully.");
              if (window.electronAPI) {
                window.electronAPI.showNotification("Build Complete", "Your site has been built successfully!").catch(() => {});
              }
              return;
            }
            if (payload.type === "failure" || payload.type === "error") {
              clearTimeout(buildTimeout);
              setToast(payload.message || "Build failed", "failure");
              setButtonEnabled(true);
              setStatus("Build failed");
              appendToConsole(payload.message || "Build failed.");
              if (window.electronAPI) {
                window.electronAPI.showNotification("Build Failed", payload.message || "Build failed").catch(() => {});
              }
              return;
            }
          });

          window.electronAPI.getReadyProdStatus().then((status) => {
            if (status?.running) {
              setButtonEnabled(false);
              setToast("Build in progress", "busy");
              setStatus("Building...");
              appendToConsole("Build already in progress on page load.");
            } else {
              setStatus("Ready");
            }
          });

          return true;
        };

        // Only setup once globally
        if (!window.__electronReadyProdSetUp) {
          window.__electronReadyProdSetUp = true;

          if (initElectronReadyProd()) {
            appendToConsole("Electron API initialized. Ready for build operations.");
            return;
          }

          // Electron API not yet available: retry a few times before giving up.
          let electronRetries = 0;
          const electronInterval = setInterval(() => {
            appendToConsole(`Checking for Electron API... attempt ${electronRetries + 1}`);
            if (initElectronReadyProd()) {
              clearInterval(electronInterval);
              appendToConsole("Electron API initialized after retry.");
              return;
            }

            electronRetries += 1;
            if (electronRetries >= 20) {
              clearInterval(electronInterval);
              setButtonEnabled(false);
              setToast("Build Site works only in Electron mode", "failure");
              appendToConsole("Electron API not available after 20 attempts. Build site disabled.");
            }
          }, 500);
        }
      };

      // Initialize on page load
      document.addEventListener("astro:page-load", initEditorPage);
      initEditorPage();
    })();
  </script>

  <style>
    body {
      padding-top: 30px;
    }
    #cms-frame {
      background: var(--background);
    }
    html[data-theme="light"] .console-pane {
      background: rgba(255, 255, 255, 0.95);
    }
    html[data-theme="light"] .console-header {
      background: rgba(248, 249, 250, 0.95);
      color: #212529;
    }
    html[data-theme="light"] .console-output {
      color: #212529;
    }
    html[data-theme="light"] .console-header button {
      color: #212529;
      border-color: #5f97c5;
    }
    #readyprod-ui {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      pointer-events: none;
    }
    #readyprod-button {
      pointer-events: auto;
      font-size: 0.85rem;
      padding: 0.45rem 0.85rem;
      border: 1px solid #5f97c5;
      border-radius: 0.35rem;
      background: rgba(16, 18, 26, 0.96);
      color: #d9e5ff;
      cursor: pointer;
    }
    #readyprod-button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    html[data-theme="light"] #readyprod-button {
      background: rgba(248, 249, 250, 0.96);
      color: #212529;
      border-color: #5f97c5;
    }
    .readyprod-toast {
      min-width: 260px;
      max-width: 320px;
      padding: 0.55rem 0.75rem;
      border-radius: 0.45rem;
      background: rgba(15, 17, 24, 0.95);
      color: #eaf3ff;
      border: 1px solid #5f97c5;
      box-shadow: 0 8px 22px rgba(0,0,0,0.45);
      font-size: 0.8rem;
      line-height: 1.3;
      word-wrap: break-word;
      pointer-events: auto;
    }
    .readyprod-toast.hidden { display: none; }
    .console-pane {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 200px;
      background: rgba(0, 0, 0, 0.9);
      border-top: 1px solid #5f97c5;
      display: flex;
      flex-direction: column;
      z-index: 1000;
    }
    .console-pane.minimized {
      height: 45px;
    }
    .console-output {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
      font-family: monospace;
      font-size: 0.75rem;
      color: #eaf3ff;
      white-space: pre-wrap;
      word-wrap: break-word;
      transition: max-height 0.3s ease;
    }
    .console-pane.minimized .console-output {
      max-height: 0;
      padding: 0;
      overflow: hidden;
    }
    .console-header {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      padding: 0.5rem;
      background: rgba(16, 18, 26, 0.9);
      border-bottom: 1px solid #5f97c5;
      font-size: 0.8rem;
      color: #eaf3ff;
    }
    .console-buttons {
      display: flex;
      gap: 0.5rem;
    }
    .console-header button {
      background: none;
      border: 1px solid #5f97c5;
      color: #eaf3ff;
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      border-radius: 0.2rem;
    }
    .console-output {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
      font-family: monospace;
      font-size: 0.75rem;
      color: #eaf3ff;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  </style>
  <style>
    .status-bar {
      position: fixed;
      bottom: 200px;
      left: 0;
      right: 0;
      height: 24px;
      background: rgba(16, 18, 26, 0.9);
      border-top: 1px solid #5f97c5;
      display: flex;
      align-items: center;
      padding: 0 1rem;
      font-size: 0.75rem;
      color: #eaf3ff;
      z-index: 999;
    }
    html[data-theme="light"] .status-bar {
      background: rgba(248, 249, 250, 0.9);
      color: #212529;
      border-color: #5f97c5;
    }
    .settings-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 10001;
    }
    .settings-modal.hidden { display: none; }
    .settings-content {
      background: #202225;
      color: #eaf3ff;
      padding: 1rem;
      border-radius: 0.5rem;
      min-width: 300px;
    }
    html[data-theme="light"] .settings-content {
      background: #f8f9fa;
      color: #212529;
    }
    .settings-content label {
      display: block;
      margin: 0.5rem 0;
    }
    .settings-content button {
      margin: 0.5rem 0.5rem 0 0;
      padding: 0.5rem;
      border: 1px solid #5f97c5;
      background: none;
      color: #eaf3ff;
      cursor: pointer;
    }
    html[data-theme="light"] .settings-content button {
      color: #212529;
    }
    #settings-btn {
      font-size: 1rem;
      width: auto;
      height: auto;
      padding: 0.45rem;
      pointer-events: auto;
      background: none;
      border: 1px solid #5f97c5;
      border-radius: 0.35rem;
      cursor: pointer;
    }
    html[data-theme="light"] #settings-btn {
      border-color: #5f97c5;
    }
    #open-browser-btn {
      font-size: 0.85rem;
      padding: 0.45rem 0.85rem;
      border: 1px solid #5f97c5;
      border-radius: 0.35rem;
      background: rgba(16, 18, 26, 0.96);
      color: #d9e5ff;
      cursor: pointer;
      pointer-events: auto;
    }
    #open-browser-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    html[data-theme="light"] #open-browser-btn {
      background: rgba(248, 249, 250, 0.96);
      color: #212529;
      border-color: #5f97c5;
    }
  <Footer />
</Layout>
