---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";

const isDev = import.meta.env.DEV;
---

<Layout title="Editor | DEADCODEXO">
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pt-3 pb-12">
    <section class="mx-auto w-full max-w-6xl rounded-2xl border border-border/40 bg-background/75 p-6 backdrop-blur-sm">
      <h1 class="text-2xl font-semibold text-accent">Content Editor</h1>
      {
        isDev ? (
          <>
            <div class="mt-5 overflow-hidden rounded-xl border border-border/40 bg-background/40">
              <iframe
                id="cms-frame"
                src="/admin/"
                title="Decap CMS"
                class="h-[68vh] min-h-[600px] w-full"
              ></iframe>
            </div>
          </>
        ) : (
          <p class="mt-3 opacity-80">
            The `/editor` route is intended for local development.
          </p>
        )
      }
    </section>
  </main>

  <div id="console-pane" class="console-pane">
    <div class="console-header">
      <span>Console Output</span>
      <button id="clear-console" type="button">Clear</button>
    </div>
    <div id="console-output" class="console-output"></div>
  </div>

  <div id="readyprod-ui" aria-live="polite">
    <button id="readyprod-button" type="button">Build Site</button>
    <div id="readyprod-toast" class="readyprod-toast hidden"></div>
  </div>
  {
    isDev && (
      <script is:inline>
        (() => {
          if (window.__cmsThemeSyncInitialized) return;
          window.__cmsThemeSyncInitialized = true;

          const resolveCmsFrameSrc = () => {
            const search = new URLSearchParams(window.location.search);
            const proxyPort = search.get("cms_proxy_port");
            if (!proxyPort || !/^\d+$/.test(proxyPort)) return "/admin/";
            return `/admin/?cms_proxy_port=${encodeURIComponent(proxyPort)}`;
          };

          const sendThemeToCmsFrame = () => {
            const frame = document.getElementById("cms-frame");
            if (!frame || !frame.contentWindow) return;

            const currentTheme =
              document.documentElement.getAttribute("data-theme") ||
              localStorage.getItem("theme") ||
              "dark";

            frame.contentWindow.postMessage(
              { type: "site-theme", value: currentTheme },
              window.location.origin
            );
          };

          const setupCmsThemeSync = () => {
            const frame = document.getElementById("cms-frame");
            if (!frame) return;

            const nextSrc = resolveCmsFrameSrc();
            if (frame.getAttribute("src") !== nextSrc) {
              frame.setAttribute("src", nextSrc);
            }

            frame.addEventListener("load", sendThemeToCmsFrame);
            sendThemeToCmsFrame();

            const observer = new MutationObserver(sendThemeToCmsFrame);
            observer.observe(document.documentElement, {
              attributes: true,
              attributeFilter: ["data-theme"],
            });

            window.addEventListener("storage", event => {
              if (event.key === "theme") sendThemeToCmsFrame();
            });
          };

          document.addEventListener("astro:page-load", setupCmsThemeSync);
          setupCmsThemeSync();
        })();
      </script>
    )
  }
  <script is:inline>
    (() => {
      const button = document.getElementById("readyprod-button");
      const toast = document.getElementById("readyprod-toast");
      const consoleOutput = document.getElementById("console-output");
      const clearConsoleBtn = document.getElementById("clear-console");

      const appendToConsole = (message) => {
        if (!consoleOutput) return;
        const timestamp = new Date().toLocaleTimeString();
        consoleOutput.textContent += `[${timestamp}] ${message}\n`;
        consoleOutput.scrollTop = consoleOutput.scrollHeight;
      };

      const setToast = (message, status) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.remove("hidden");
        toast.style.borderColor = status === "success" ? "#42c567" : status === "failure" ? "#f16353" : "#5f97c5";
        if (status !== "busy") {
          setTimeout(() => {
            toast.classList.add("hidden");
          }, 3600);
        }
      };
      const setButtonEnabled = (enabled) => {
        if (!button) return;
        button.disabled = !enabled;
      };

      if (clearConsoleBtn) {
        clearConsoleBtn.addEventListener("click", () => {
          if (consoleOutput) consoleOutput.textContent = "";
        });
      }

      const initElectronReadyProd = () => {
        if (!button) return false;

        if (!window.electronAPI) {
          return false;
        }

        let buildTimeout = null;

        button.addEventListener("click", () => {
          setButtonEnabled(false);
          setToast("Building site...", "busy");
          appendToConsole("Starting build site...");

          // Fallback: re-enable after 90s if stuck
          buildTimeout = setTimeout(() => {
            setButtonEnabled(true);
            setToast("Build timed out — try again", "failure");
            appendToConsole("Build timed out after 90 seconds.");
          }, 90000);

          window.electronAPI.runReadyProd().catch(() => {
            clearTimeout(buildTimeout);
            setButtonEnabled(true);
            setToast("Build failed", "failure");
            appendToConsole("Build failed.");
          });
        });

        window.electronAPI.onReadyProdEvent((payload) => {
          if (!payload) return;
          if (payload.type === "start" || payload.type === "trigger" || payload.type === "busy") {
            setToast(payload.message || "Building site...", "busy");
            setButtonEnabled(false);
            appendToConsole(payload.message || "Build started.");
            return;
          }
          if (payload.type === "log") {
            setToast(payload.message, "busy");
            appendToConsole(payload.message);
            return;
          }
          if (payload.type === "success") {
            clearTimeout(buildTimeout);
            setToast(payload.message || "Build complete", "success");
            setButtonEnabled(true);
            appendToConsole(payload.message || "Build completed successfully.");
            return;
          }
          if (payload.type === "failure" || payload.type === "error") {
            clearTimeout(buildTimeout);
            setToast(payload.message || "Build failed", "failure");
            setButtonEnabled(true);
            appendToConsole(payload.message || "Build failed.");
            return;
          }
        });

        window.electronAPI.getReadyProdStatus().then((status) => {
          if (status?.running) {
            setButtonEnabled(false);
            setToast("Build in progress", "busy");
            appendToConsole("Build already in progress on page load.");
          }
        });

        return true;
      };

      if (initElectronReadyProd()) {
        appendToConsole("Electron API initialized. Ready for build operations.");
        return;
      }

      // Electron API not yet available: retry a few times before giving up.
      let electronRetries = 0;
      const electronInterval = setInterval(() => {
        appendToConsole(`Checking for Electron API... attempt ${electronRetries + 1}`);
        if (initElectronReadyProd()) {
          clearInterval(electronInterval);
          appendToConsole("Electron API initialized after retry.");
          return;
        }

        electronRetries += 1;
        if (electronRetries >= 20) {
          clearInterval(electronInterval);
          setButtonEnabled(false);
          setToast("Build Site works only in Electron mode", "failure");
          appendToConsole("Electron API not available after 20 attempts. Build site disabled.");
        }
      }, 500);
    })();
  </script>

  <style>
    #cms-frame {
      background: var(--background);
    }
    #readyprod-ui {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      pointer-events: none;
    }
    #readyprod-button {
      pointer-events: auto;
      font-size: 0.85rem;
      padding: 0.45rem 0.85rem;
      border: 1px solid #5f97c5;
      border-radius: 0.35rem;
      background: rgba(16, 18, 26, 0.96);
      color: #d9e5ff;
      cursor: pointer;
    }
    #readyprod-button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .readyprod-toast {
      min-width: 260px;
      max-width: 320px;
      padding: 0.55rem 0.75rem;
      border-radius: 0.45rem;
      background: rgba(15, 17, 24, 0.95);
      color: #eaf3ff;
      border: 1px solid #5f97c5;
      box-shadow: 0 8px 22px rgba(0,0,0,0.45);
      font-size: 0.8rem;
      line-height: 1.3;
      word-wrap: break-word;
      pointer-events: auto;
    }
    .readyprod-toast.hidden { display: none; }
    .console-pane {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 200px;
      background: rgba(0, 0, 0, 0.9);
      border-top: 1px solid #5f97c5;
      display: flex;
      flex-direction: column;
      z-index: 1000;
    }
    .console-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem;
      background: rgba(16, 18, 26, 0.9);
      border-bottom: 1px solid #5f97c5;
      font-size: 0.8rem;
      color: #eaf3ff;
    }
    .console-header button {
      background: none;
      border: 1px solid #5f97c5;
      color: #eaf3ff;
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      border-radius: 0.2rem;
    }
    .console-output {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem;
      font-family: monospace;
      font-size: 0.75rem;
      color: #eaf3ff;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
  </style>
  <Footer />
</Layout>
