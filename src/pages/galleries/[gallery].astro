---
import type { GetStaticPaths } from "astro";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import { SITE } from "@/config";
import { slugifyStr } from "@/utils/slugify";

type GalleryProps = {
  gallery: CollectionEntry<"galleries">;
};

export const getStaticPaths = (async () => {
  const galleries = await getCollection("galleries", ({ data }) => !data.draft);

  return galleries.map(gallery => ({
    params: {
      gallery: gallery.id
        .replace(/\\/g, "/")
        .replace(/\/index\.(md|mdx)$/i, "")
        .replace(/\.(md|mdx)$/i, "")
        .replace(/\/index$/i, ""),
    },
    props: { gallery },
  }));
}) satisfies GetStaticPaths;

const { gallery } = Astro.props as GalleryProps;
const slug = gallery.id
  .replace(/\\/g, "/")
  .replace(/\/index\.(md|mdx)$/i, "")
  .replace(/\.(md|mdx)$/i, "")
  .replace(/\/index$/i, "");
const { Content } = await render(gallery);

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/data/galleries/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG,WEBP}",
  { eager: true }
);

function filenameToAlt(filename: string, fallback: string): string {
  return (
    filename
      .replace(/\.[^.]+$/, "")
      .replace(/^\d+[-_]?/, "")
      .replace(/[-_]/g, " ")
      .replace(/\b\w/g, ch => ch.toUpperCase())
      .trim() || fallback
  );
}

const images = Object.entries(allImages)
  .filter(([filePath]) => filePath.startsWith(`/src/data/galleries/${slug}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([filePath, mod]) => {
    const filename = filePath.split("/").pop() ?? "";
    return {
      src: mod.default,
      alt: filenameToAlt(filename, gallery.data.title),
    };
  });

const title = `${gallery.data.title} | Galleries | ${SITE.title}`;
---

<Layout title={title} description={gallery.data.description}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-12">
    <header class="gallery-header">
      <h1 class="text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
        {gallery.data.title}
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-foreground/70 italic">
        {gallery.data.description}
      </p>

      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        <span class="meta-chip">
          <Datetime pubDatetime={gallery.data.pubDatetime} class="[&>svg]:hidden" />
        </span>
        <span class="meta-chip">
          {images.length} {images.length === 1 ? "image" : "images"}
        </span>
        {
          gallery.data.tags.map(tag => (
            <a class="meta-chip hover-chip" href={`/tags/${slugifyStr(tag)}/`}>
              #{tag}
            </a>
          ))
        }
      </div>
    </header>

    {
      images.length === 0 ? (
        <div class="empty-state">
          <h2 class="text-lg font-semibold">No images in this gallery yet</h2>
          <p class="mt-2 text-sm opacity-70">
            Add images inside <code>src/data/galleries/{slug}/</code> and rebuild.
          </p>
        </div>
      ) : (
        <section class="gallery-grid" aria-label={gallery.data.title}>
          {images.map((img, index) => (
            <a
              href={img.src.src}
              target="_blank"
              rel="noreferrer"
              class="gallery-item"
              aria-label={`Open image ${index + 1}: ${img.alt}`}
            >
              <Image
                src={img.src}
                alt={img.alt}
                class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
                loading={index < 4 ? "eager" : "lazy"}
                widths={[500, 900, 1400]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              />
            </a>
          ))}
        </section>
      )
    }

    <article class="app-prose mt-10 w-full max-w-app">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .gallery-header {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 2rem 1.5rem;
    margin-bottom: 1.5rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  @media (min-width: 640px) {
    .gallery-header {
      padding: 2.5rem;
    }
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 14%, transparent);
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    padding: 0.3rem 0.8rem;
    color: var(--color-accent);
  }

  .hover-chip {
    transition: all 0.2s ease;
  }

  .hover-chip:hover {
    border-color: color-mix(in srgb, var(--color-accent) 30%, transparent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
    background: color-mix(in srgb, var(--color-muted) 10%, transparent);
    aspect-ratio: 4 / 3;
    display: block;
  }

  .gallery-item:hover {
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }

  .empty-state {
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 25%, transparent);
    background: color-mix(in srgb, var(--color-muted) 15%, transparent);
    padding: 1rem 1.25rem;
  }
</style>
